# NIA portal vhost (container).
#
# This file is rendered by the official nginx image's
# /docker-entrypoint.d/20-envsubst-on-templates.sh step into
# /etc/nginx/conf.d/default.conf, substituting the *defined* environment
# variables below. Set them on the container:
#
#   NIA_FRONTEND_HOST  listen address (default 0.0.0.0)
#   NIA_FRONTEND_PORT  listen port    (default 8080)
#
# Only these two placeholders are used; the lowercase nginx variables ($uri, …)
# are left untouched because no environment variable of that name is defined.

server {
    listen ${NIA_FRONTEND_HOST}:${NIA_FRONTEND_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Never emit absolute redirects: behind the reverse proxy nginx only knows the
    # internal scheme/port, so a relative Location header is the correct one.
    absolute_redirect off;

    # Log to the container's stdout/stderr (set in the base image).
    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Container health probe (handy for the reverse proxy / orchestrator).
    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    # Content-hashed build assets never change.
    location /_nuxt/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The app is a client-rendered SPA: route shells are served via
    # `$uri/index.html`, and anything else falls back to the SPA shell.
    location / {
        try_files $uri $uri/index.html /200.html;
    }
}

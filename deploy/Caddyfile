# Caddy configuration for the NIA portal (static hosting).
#
# Build with `pnpm generate` and point `root` at a copy of `.output/public`.

nia.gov.dn42 {
	root * /var/www/nia-gov42

	encode zstd gzip

	# The app is a client-rendered SPA; fall back to the 200.html shell.
	try_files {path} {path}/ {path}.html /200.html

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Inline colour-mode bootstrap script and Naive UI inline styles.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	file_server

	# dn42 TLS: Caddy uses an internal CA unless a certificate is configured.
	tls internal
}
